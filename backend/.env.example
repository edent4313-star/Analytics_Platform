# ─────────────────────────────────────────────────────────────────────────────
# Enterprise Analytics Platform — Environment Configuration
# Copy this file to .env and fill in real values before starting the application.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Enterprise Analytics Platform
APP_ENV=development
# Set to production when deploying
APP_VERSION=1.0.0
DEBUG=false

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_64_CHARACTERS

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_HOURS=8

# Fernet symmetric encryption key for data source credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ── PostgreSQL Application Database ──────────────────────────────────────────
# This is the application DB (users, roles, dashboards, config).
# NOT the analytical data source.
DATABASE_URL=postgresql://analytics_user:analytics_pass@localhost:5432/analytics_platform

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Oracle Analytical Data Source (optional) ─────────────────────────────────
# Leave blank if Oracle is not in use.
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=
ORACLE_USERNAME=
ORACLE_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────────────────────
# In production set this to your internal server URL (no trailing slash).
# Comma-separated list for multiple origins during development.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
